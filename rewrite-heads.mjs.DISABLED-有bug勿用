// 定点返工：只改「段首 2 字重复过多」的段落，用路由的段落级修订，逐段替换
// 用法: node rewrite-heads.mjs <章号> [--dry] [--max N]
import fs from 'node:fs';
import path from 'node:path';

const BASE = 'http://127.0.0.1:3812';
const API = BASE + '/api/dsh-novel-forge/rewrite';
const DIR = 'H:\\novels\\还债疯了';
const no = Number(process.argv[2]);
const dry = process.argv.includes('--dry');
const maxArg = process.argv.indexOf('--max');
const MAX = maxArg > 0 ? Number(process.argv[maxArg + 1]) : 12;

const proj = JSON.parse(fs.readFileSync(path.join(DIR, 'novel-project.json'), 'utf8'));
const ch = proj.chapters.find((c) => c.no === no);
if (!ch || !ch.file) {
  console.log(JSON.stringify({ ok: false, error: 'chapter not found' }));
  process.exit(1);
}
const file = path.join(DIR, ch.file);
const raw = fs.readFileSync(file, 'utf8').replace(/\r\n/g, '\n');
const lines = raw.split('\n');
const title = lines[0].startsWith('#') ? lines.shift() : '';

// 段落切分（空行分隔）
const paras = [];
{
  let cur = [];
  for (const ln of lines) {
    if (ln.trim() === '') {
      if (cur.length) paras.push(cur.join('\n'));
      cur = [];
    } else cur.push(ln);
  }
  if (cur.length) paras.push(cur.join('\n'));
}
const isDialog = (p) => /^[\u201C\u300C"]/.test(p.trim());
const headOf = (p) => p.trim().replace(/^[\u201C\u300C"]/, '').slice(0, 2);

// 统计叙述段段首
const narIdx = paras.map((p, i) => (isDialog(p) ? -1 : i)).filter((i) => i >= 0);
const count = {};
for (const i of narIdx) count[headOf(paras[i])] = (count[headOf(paras[i])] || 0) + 1;

// 选出要改的段落：同一段首保留前 2 个，其余入选；按段首频次高的优先
const seen = {};
const picked = [];
for (const i of narIdx) {
  const h = headOf(paras[i]);
  if ((count[h] || 0) < 3) continue;
  seen[h] = (seen[h] || 0) + 1;
  if (seen[h] > 2) picked.push({ i, head: h, p: paras[i] });
}
picked.sort((a, b) => (count[b.head] || 0) - (count[a.head] || 0) || a.i - b.i);
const todo = picked.slice(0, MAX);

const FOCUS =
  '只改这一段「开头第一句」的结构，不改情节、不改人物、不改数字、不删主语。\n' +
  '原文段首用「' +
  '{{HEAD}}' +
  '」起句，本章这种开头已经出现多次，读起来重复。\n' +
  '请换一种入口：以环境（器物/声音/气味/温度/光线）、身体感受、时间、方位，或把对话整段前置。\n' +
  '硬性要求：\n' +
  '1. 主语必须保留或明确——严禁出现「光杆动词开头」的无主语残句。\n' +
  '2. 段落其余部分若与开头无冲突，尽量原样保留，但改写后全段必须通顺连贯。\n' +
  '3. 只输出这一段的新文本，不要标题、不要说明、不要 Markdown 标记。';

async function rewritePara(paragraph, head) {
  const res = await fetch(API, {
    method: 'POST',
    headers: { 'content-type': 'application/json' },
    body: JSON.stringify({ chapterNo: no, target: paragraph, instructions: FOCUS.replace('{{HEAD}}', head) }),
  });
  if (!res.ok || !res.body) return { ok: false, error: 'http ' + res.status };
  const reader = res.body.getReader();
  const dec = new TextDecoder();
  let buf = '';
  let draft = '';
  let err = '';
  while (true) {
    const { done, value } = await reader.read();
    if (done) break;
    buf += dec.decode(value, { stream: true });
    const ls = buf.split('\n');
    buf = ls.pop() ?? '';
    for (const l of ls) {
      if (!l.trim()) continue;
      let f;
      try {
        f = JSON.parse(l);
      } catch {
        continue;
      }
      if (f.type === 'draft' || f.type === 'delta') draft += f.text ?? '';
      else if (f.type === 'drafted' && f.draft) draft = f.draft;
      else if (f.type === 'error') err = f.message ?? 'err';
    }
  }
  if (err) return { ok: false, error: err };
  const t = draft.trim();
  if (!t) return { ok: false, error: 'empty' };
  return { ok: true, text: t };
}

const out = { ok: true, no, title: ch.title, narParas: narIdx.length, repeatHeads: Object.entries(count).filter(([, v]) => v >= 3), picked: picked.length, changed: [], failed: [] };
for (const t of todo) {
  const r = await rewritePara(t.p, t.head);
  if (r.ok) {
    paras[t.i] = r.text;
    out.changed.push({ i: t.i, head: t.head, before: t.p.slice(0, 24), after: r.text.slice(0, 24) });
  } else {
    out.failed.push({ i: t.i, error: r.error });
  }
}

if (!dry && out.changed.length) {
  const body = paras.join('\n\n');
  fs.copyFileSync(file, file.replace(/\.md$/, '.pre-heads.bak.md'));
  fs.writeFileSync(file, (title ? title + '\n\n' : '') + body + '\n', 'utf8');
  out.wrote = ch.file;
}
out.changedCount = out.changed.length;
out.failedCount = out.failed.length;
console.log(JSON.stringify(out));
